<Project Sdk="Microsoft.NET.Sdk">
  <!--
    OpenTelemetry.Api is pinned per target framework so that its System.Diagnostics.DiagnosticSource
    dependency always supports that framework:
    - 1.20.1 is the last release with net8.0/net9.0 assets (DiagnosticSource 10.0.0, supports net8.0+).
      1.21.0+ falls back to netstandard2.0 there and pulls DiagnosticSource 11.0.0, which only supports net10.0+.
    - 1.21.0 depends on DiagnosticSource 11.0.0 on net10.0 and uses the in-box version on net11.0.
  -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" Condition="'$(TargetFramework)' == 'net8.0'" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Api" Condition="'$(TargetFramework)' == 'net9.0'" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Api" Condition="'$(TargetFramework)' == 'net10.0'" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Api" Condition="'$(TargetFramework)' == 'net11.0'" Version="1.21.0" />
  </ItemGroup>
</Project>
